{
  "name": "clinic-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "preview": "electron-vite preview",
    "test": "node --test",
    "smoke:window": "node scripts/window-smoke.mjs"
  },
  "build": {
    "appId": "com.clinicdesk.desktop",
    "productName": "Clinic Desk",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "package.json", "!**/.env", "!**/*.sqlite"],
    "asar": true,
    "win": { "target": "nsis", "artifactName": "ClinicDesk-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "publish": [{ "provider": "github", "owner": "MuneebMughal12", "repo": "clinic-mangment-system-" }]
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "dotenv": "^18.0.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.9",
    "vite": "^7.3.6"
  }
}
